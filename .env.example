# Copy to .env and set your Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides (auto-discovered at runtime if omitted)
# VOUCH_LIVE_MODEL=gemini-3.8-live
# VOUCH_REPORT_MODEL=gemini-4-carbon
# VOUCH_TTS_MODEL=gemini-3.8-flash-tts

# Optional runtime settings
# PORT=8080
# VOUCH_MOCK=0
# VOUCH_TEST_MODE=0
# VOUCH_SERVICE_NAME=vouch
